# Raw data (~1.2 GB) -- public on GEO (GSE164378), not something git should carry
data/*.gz

# Hao et al. 2021 celltype reference (~2.06 GB) -- exceeds GitHub's 100 MB
# limit, publicly downloadable from the paper (see README "Data"), not
# something git should carry. The extracted celltype_annotations.csv
# (barcode + celltype.l1/l2/l3 columns, ~7 MB) IS committed -- that's
# the only part the pipeline actually reads.
reference/*.h5seurat

# Pipeline checkpoints (~31 GB total, every file exceeds GitHub's 100 MB
# limit individually) -- fully reproducible by running the pipeline
# against data/ above
results/*.rds

# Snakemake's own local run-tracking state -- regenerates automatically,
# not portable across machines
.snakemake/

# run_pipeline.sh's timestamped log files -- local run output, not source
logs/
